---
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
    {
        title: 'Manual de Sobrevivência para Malha Fina',
        excerpt: 'Entenda como agir e quais documentos ter em mãos ao receber notificações da Receita Federal.',
        category: 'Gestão',
        date: '08 Mar, 2024',
        readTime: '8 min',
        image: '/assets/img/image_6.jpg',
        alt: 'Notificação da Receita Federal em mesa de escritório com documentos organizados',
        href: '/blog/malha-fina'
    },
    {
        title: 'Holding Familiar: Proteção e Sucessão',
        excerpt: 'Os benefícios práticos de estruturar o patrimônio familiar como uma estratégia de blindagem.',
        category: 'Holding',
        date: '02 Mar, 2024',
        readTime: '15 min',
        image: '/assets/img/image_7.jpg',
        alt: 'Documentos de planejamento patrimonial em mesa elegante com iluminação suave',
        href: '/blog/holding-familiar'
    }
];
---

<BaseLayout
    title="Insights & Inteligência Fiscal | Blog ContábilPro"
    description="As últimas notícias sobre reforma tributária, gestão de PMEs e tecnologia no setor contábil. Mantenha seu negócio à frente."
    currentPage="blog"
    ogImage="/assets/img/image_11.jpg"
>
    <main class="pt-24">
        <!-- Hero / Featured -->
        <section data-aos="fade-up" class="px-8 max-w-7xl mx-auto mb-20">
            <div class="mb-12">
                <h1 class="text-4xl md:text-5xl lg:text-5xl font-headline font-bold text-on-surface mb-4">Insights e Inteligência Fiscal</h1>
                <p class="text-on-surface-variant text-lg max-w-2xl font-body">Análises técnicas e curadoria estratégica para arquitetar a soberania financeira do seu negócio.</p>
            </div>

            <!-- Featured Card -->
            <article data-aos="zoom-in" class="relative h-[500px] rounded-3xl overflow-hidden group cursor-pointer shadow-2xl">
                <img src="/assets/img/image_11.jpg"
                     alt="Inteligência artificial aplicada à análise tributária em dashboard moderno"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                     width="1200" height="500"
                     loading="eager" fetchpriority="high" />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8 md:p-12 max-w-3xl">
                    <span class="inline-block px-4 py-1 rounded-full bg-primary text-white text-xs font-bold uppercase tracking-widest mb-4">Destaque da Semana</span>
                    <a href="/blog/ia-tributaria" class="block">
                        <h2 class="text-3xl md:text-5xl font-headline font-bold text-white mb-4 group-hover:text-primary-fixed-dim transition-colors leading-tight">O Impacto da Inteligência Artificial na Estratégia Tributária de 2026</h2>
                    </a>
                    <p class="text-slate-300 text-lg mb-6 line-clamp-2">Como novos algoritmos de auditoria estão redefinindo a conformidade e as oportunidades de recuperação fiscal para PMEs de alto crescimento.</p>
                    <div class="flex items-center gap-6 text-sm text-slate-400 font-medium">
                        <span class="flex items-center gap-2"><span class="material-symbols-outlined text-sm" aria-hidden="true">calendar_today</span> 10 Abr, 2026</span>
                        <span class="flex items-center gap-2"><span class="material-symbols-outlined text-sm" aria-hidden="true">schedule</span> 12 min leitura</span>
                    </div>
                </div>
            </article>
        </section>

        <!-- Search & Filter -->
        <div class="max-w-7xl mx-auto px-8 mb-12 flex flex-col md:flex-row justify-between items-center gap-6" id="blog-filtros">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 w-full md:w-auto invisible-scrollbar">
                <button class="whitespace-nowrap px-6 py-2 rounded-full bg-primary text-white font-semibold text-sm">Todos</button>
                <button class="whitespace-nowrap px-6 py-2 rounded-full bg-white border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-all text-sm font-medium">Gestão</button>
                <button class="whitespace-nowrap px-6 py-2 rounded-full bg-white border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-all text-sm font-medium">Fiscal</button>
                <button class="whitespace-nowrap px-6 py-2 rounded-full bg-white border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-all text-sm font-medium">Compliance</button>
                <button class="whitespace-nowrap px-6 py-2 rounded-full bg-white border border-slate-200 text-slate-600 hover:border-primary hover:text-primary transition-all text-sm font-medium">MEI</button>
            </div>
            <div class="relative w-full md:w-80">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400 pointer-events-none" aria-hidden="true">search</span>
                <input type="search"
                       placeholder="Buscar artigos..."
                       aria-label="Buscar artigos no blog"
                       class="w-full pl-12 pr-4 py-3 rounded-full border-slate-200 focus:border-primary focus:ring-primary transition-all bg-white text-sm" />
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 pb-24">
            <!-- Main Grid -->
            <div class="lg:col-span-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {articles.map(article => (
                        <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 group blog-card">
                            <div class="h-48 overflow-hidden">
                                <img src={article.image}
                                     alt={article.alt}
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                     width="600" height="192"
                                     loading="lazy" decoding="async" />
                            </div>
                            <div class="p-6">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-primary px-2 py-1 bg-primary/10 rounded">{article.category}</span>
                                    <span class="text-[10px] text-slate-400 font-medium">{article.date}</span>
                                </div>
                                <a href={article.href} class="block">
                                    <h3 class="text-xl font-headline font-bold mb-3 group-hover:text-primary transition-colors leading-tight">{article.title}</h3>
                                </a>
                                <p class="text-slate-500 text-sm line-clamp-2 mb-6 font-body">{article.excerpt}</p>
                                <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-slate-400 text-sm" aria-hidden="true">schedule</span>
                                        <span class="text-xs text-slate-400">{article.readTime}</span>
                                    </div>
                                    <a href={article.href}
                                       class="text-primary text-xs font-bold flex items-center gap-1 hover:gap-2 transition-all">
                                        Ler artigo
                                        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>

                <!-- Pagination -->
                <div class="mt-16 flex justify-center items-center gap-2">
                    <button class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:border-primary hover:text-primary transition-all" aria-label="Página anterior">
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">chevron_left</span>
                    </button>
                    <button class="w-10 h-10 rounded-full bg-primary text-white font-bold text-sm" aria-current="page">1</button>
                    <button class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:border-primary hover:text-primary transition-all text-sm">2</button>
                    <button class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:border-primary hover:text-primary transition-all text-sm">3</button>
                    <button class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:border-primary hover:text-primary transition-all" aria-label="Próxima página">
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">chevron_right</span>
                    </button>
                </div>
            </div>

            <!-- Sidebar -->
            <aside class="lg:col-span-4 space-y-12">
                <!-- Newsletter -->
                <div class="bg-slate-900 rounded-3xl p-8 text-white relative overflow-hidden">
                    <div class="relative z-10">
                        <h3 class="text-2xl font-headline font-bold mb-2 italic">Radar Fiscal</h3>
                        <p class="text-slate-400 text-sm mb-6">Receba curadoria estratégica semanal no seu e-mail.</p>
                        <form id="newsletter-form" class="space-y-4">
                            <input type="email"
                                   placeholder="E-mail profissional"
                                   aria-label="Seu e-mail profissional"
                                   required
                                   class="w-full bg-white/5 border-white/10 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary focus:border-primary" />
                            <button type="submit"
                                    class="w-full bg-primary hover:bg-primary-container text-white font-bold py-3 rounded-xl transition-all">
                                Quero Assinar
                            </button>
                        </form>
                    </div>
                    <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/20 blur-3xl rounded-full"></div>
                </div>

                <!-- Popular Posts -->
                <div>
                    <h4 class="text-sm font-bold uppercase tracking-widest text-slate-900 mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-lg" aria-hidden="true">trending_up</span> Em Alta
                    </h4>
                    <ul class="space-y-8">
                        <li class="group flex gap-4">
                            <span class="text-3xl font-headline text-slate-200 group-hover:text-primary transition-colors">01</span>
                            <div>
                                <a href="/blog/reduzir-impostos-simples" class="font-bold text-slate-900 leading-snug hover:text-primary transition-colors block mb-1">Como Reduzir Impostos Legalmente no Simples Nacional</a>
                                <span class="text-[10px] text-slate-400 uppercase font-medium">10 min leitura</span>
                            </div>
                        </li>
                        <li class="group flex gap-4">
                            <span class="text-3xl font-headline text-slate-200 group-hover:text-primary transition-colors">02</span>
                            <div>
                                <a href="/blog/pix-fiscalizacao" class="font-bold text-slate-900 leading-snug hover:text-primary transition-colors block mb-1">O Impacto do Pix na Fiscalização do Banco Central</a>
                                <span class="text-[10px] text-slate-400 uppercase font-medium">6 min leitura</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </main>
</BaseLayout>
