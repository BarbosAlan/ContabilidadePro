---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "AccountingService",
    "name": "ContábilPro",
    "description": "Excelência em arquitetura contábil e consultoria estratégica para PMEs",
    "url": "https://www.contabilpro.com.br",
    "telephone": "+55-21-4004-0000",
    "email": "contato@contabilpro.com.br",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Visconde de Pirajá, Ipanema",
        "addressLocality": "Rio de Janeiro",
        "addressRegion": "RJ",
        "addressCountry": "BR"
    },
    "priceRange": "$$",
    "openingHours": "Mo-Fr 08:00-18:00",
    "image": "https://www.contabilpro.com.br/assets/img/image_15.jpg",
    "sameAs": [
        "https://www.instagram.com/contabilpro",
        "https://www.linkedin.com/company/contabilpro"
    ],
    "areaServed": "BR"
};
---

<BaseLayout
    title="ContábilPro | Inteligência e Arquitetura Contábil Estratégica"
    description="Excelência em consultoria contábil para PMEs que buscam crescimento sustentável e soberania financeira. Diagnóstico fiscal gratuito em 24h."
    currentPage="index"
    ogImage="/assets/img/image_15.jpg"
    {jsonLd}
>
    <!-- Hero Section -->
    <section data-aos="fade-up" class="relative bg-slate-950 text-white pt-32 pb-24 lg:pt-40 lg:pb-32 overflow-hidden">
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 -left-1/4 w-1/2 h-full bg-primary/30 blur-[120px] rounded-full"></div>
            <div class="absolute bottom-0 -right-1/4 w-1/2 h-full bg-tertiary/20 blur-[120px] rounded-full"></div>
        </div>
        <div class="max-w-7xl mx-auto px-8 relative z-10 grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7">
                <h1 class="text-4xl md:text-5xl lg:text-7xl leading-[1.1] font-medium mb-6 display-serif">
                    Nós cuidamos da burocracia para você focar em lucrar
                </h1>
                <p class="text-xl text-slate-300 mb-10 max-w-xl font-body leading-relaxed">
                    Contabilidade feita por pessoas reais para PMEs. Chega de pagar impostos indevidos por falhas de enquadramento.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                    <a href="https://wa.me/5521933445566?text=Ol%C3%A1!%20Gostaria%20de%20uma%20consultoria%20gratuita."
                       class="w-full sm:w-auto bg-primary text-white px-8 py-4 rounded-xl font-bold btn-lift flex items-center justify-center gap-2"
                       target="_blank"
                       rel="noopener noreferrer">
                        <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                        WhatsApp
                    </a>
                    <a href="/servicos"
                       class="w-full sm:w-auto border border-white/20 text-white px-8 py-4 rounded-xl font-bold hover:bg-white/10 transition-all flex items-center justify-center">
                        Ver Planos
                    </a>
                </div>
            </div>
            <div class="lg:col-span-5 block">
                <div class="relative">
                    <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-4 lg:p-6 shadow-2xl opacity-60 lg:opacity-100">
                        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=800&q=80"
                             alt="Equipe trabalhando junta com foco e seriedade no escritório"
                             class="rounded-xl shadow-lg grayscale-[0.2] h-48 lg:h-auto w-full object-cover"
                             width="800"
                             height="500"
                             loading="eager"
                             fetchpriority="high" />
                    </div>
                    <div class="absolute -bottom-4 -left-4 lg:-bottom-6 lg:-left-6 bg-tertiary-container p-3 lg:p-4 rounded-xl text-white shadow-xl flex items-center gap-3 lg:gap-4 scale-90 lg:scale-100">
                        <span class="material-symbols-outlined text-3xl lg:text-4xl" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">trending_up</span>
                        <div>
                            <div class="text-xl lg:text-2xl font-bold font-headline leading-tight">+35%</div>
                            <div class="text-[8px] lg:text-[10px] uppercase tracking-widest opacity-80">Eficiência Fiscal</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Serviços Section -->
    <section data-aos="fade-up" class="py-24 bg-surface" id="servicos">
        <div class="max-w-7xl mx-auto px-8">
            <div class="mb-16 max-w-2xl">
                <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs">O que fazemos de melhor</span>
                <h2 class="text-4xl lg:text-5xl mt-4 mb-6">Como podemos blindar seu caixa hoje</h2>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="group bg-surface-container-lowest p-8 rounded-xl transition-all hover:translate-y-[-8px] hover:shadow-xl">
                    <div class="w-14 h-14 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-3xl" aria-hidden="true">domain_add</span>
                    </div>
                    <h3 class="text-2xl mb-4 font-headline">Abertura de Empresa</h3>
                    <p class="text-slate-600 leading-relaxed mb-6 font-body">Legalização rápida e segura. Analisamos o melhor regime tributário para o seu início de jornada.</p>
                    <a class="inline-flex items-center gap-1 text-primary font-semibold text-sm group-hover:gap-2 transition-all" href="/servicos#abertura">
                        Saiba mais <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                    </a>
                </div>
                <div class="group bg-surface-container-lowest p-8 rounded-xl transition-all hover:translate-y-[-8px] hover:shadow-xl">
                    <div class="w-14 h-14 bg-tertiary/10 text-tertiary rounded-lg flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-3xl" aria-hidden="true">account_balance_wallet</span>
                    </div>
                    <h3 class="text-2xl mb-4 font-headline">Gestão Contábil</h3>
                    <p class="text-slate-600 leading-relaxed mb-6 font-body">Escrituração digital, balancetes mensais e controle rigoroso para sua tomada de decisão estratégica.</p>
                    <a class="inline-flex items-center gap-1 text-primary font-semibold text-sm group-hover:gap-2 transition-all" href="/servicos#gestao">
                        Saiba mais <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                    </a>
                </div>
                <div class="group bg-surface-container-lowest p-8 rounded-xl transition-all hover:translate-y-[-8px] hover:shadow-xl">
                    <div class="w-14 h-14 bg-primary-container/10 text-primary-container rounded-lg flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-3xl" aria-hidden="true">query_stats</span>
                    </div>
                    <h3 class="text-2xl mb-4 font-headline">Planejamento Tributário</h3>
                    <p class="text-slate-600 leading-relaxed mb-6 font-body">Redução legal da carga tributária. Inteligência fiscal para maximizar os lucros da sua empresa.</p>
                    <a class="inline-flex items-center gap-1 text-primary font-semibold text-sm group-hover:gap-2 transition-all" href="/servicos#planejamento">
                        Saiba mais <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Diferenciais -->
    <section data-aos="fade-up" class="py-24 bg-surface-container-low" id="diferenciais">
        <div class="max-w-7xl mx-auto px-8">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div>
                    <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs">Por que a ContábilPro</span>
                    <h2 class="text-4xl lg:text-5xl mt-4 mb-8">Mais que contadores, seus parceiros de negócio</h2>
                    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-12">
                        <div class="flex flex-col gap-3">
                            <span class="material-symbols-outlined text-primary text-3xl" aria-hidden="true">shield_person</span>
                            <h4 class="font-bold text-lg">Segurança</h4>
                            <p class="text-sm text-slate-500 leading-relaxed">Conformidade total com a LGPD e normas do CFC para sua paz de espírito.</p>
                        </div>
                        <div class="flex flex-col gap-3">
                            <span class="material-symbols-outlined text-primary text-3xl" aria-hidden="true">bolt</span>
                            <h4 class="font-bold text-lg">Tecnologia</h4>
                            <p class="text-sm text-slate-500 leading-relaxed">Integrações automáticas com ERPs e dashboards financeiros em tempo real.</p>
                        </div>
                        <div class="flex flex-col gap-3">
                            <span class="material-symbols-outlined text-primary text-3xl" aria-hidden="true">support_agent</span>
                            <h4 class="font-bold text-lg">Atendimento</h4>
                            <p class="text-sm text-slate-500 leading-relaxed">Consultores dedicados prontos para resolver suas dúvidas em minutos.</p>
                        </div>
                        <div class="flex flex-col gap-3">
                            <span class="material-symbols-outlined text-primary text-3xl" aria-hidden="true">savings</span>
                            <h4 class="font-bold text-lg">Economia</h4>
                            <p class="text-sm text-slate-500 leading-relaxed">Recuperação de créditos e redução drástica de impostos evitáveis.</p>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80"
                         alt="Profissionais comemorando resultados de forma casual"
                         class="rounded-xl shadow-2xl"
                         width="600"
                         height="400"
                         loading="lazy"
                         decoding="async" />
                    <div class="absolute top-1/2 -right-12 -translate-y-1/2 hidden xl:block">
                        <div class="bg-white p-6 rounded-xl shadow-xl space-y-4 max-w-[200px]">
                            <div class="flex -space-x-2">
                                <div class="w-8 h-8 rounded-full bg-slate-200 border-2 border-white"></div>
                                <div class="w-8 h-8 rounded-full bg-slate-300 border-2 border-white"></div>
                                <div class="w-8 h-8 rounded-full bg-slate-400 border-2 border-white"></div>
                            </div>
                            <p class="text-xs font-medium text-slate-600">+500 Empresas Confiam</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Prova Social -->
    <section data-aos="fade-up" class="py-24 bg-surface" id="clientes">
        <div class="max-w-7xl mx-auto px-8">
            <div class="text-center mb-16 max-w-2xl mx-auto">
                <h2 class="text-3xl lg:text-4xl font-headline mb-4">Quem já teve o caixa salvo por nós</h2>
                <p class="text-slate-600">Histórias de empreendedores brasileiros que pararam de brigar com a Receita Federal e foram focar no próprio negócio.</p>
            </div>
            
            <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                <!-- Depoimento 1 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/10 relative flex flex-col h-full">
                    <span class="material-symbols-outlined text-primary/20 text-5xl absolute top-6 right-6" aria-hidden="true">format_quote</span>
                    <p class="text-slate-700 leading-relaxed mb-6 relative z-10 flex-grow">
                        "Abri meu MEI com a ajuda deles e não entendi nada do processo — mas o bom é que não precisei entender. Eles cuidaram de tudo e me explicaram só o que era importante pra não tomar multa. Até hoje tiro dúvidas direto pelo WhatsApp."
                    </p>
                    <div class="flex items-center gap-4 mt-auto">
                        <div class="w-12 h-12 rounded-full bg-rose-500 flex items-center justify-center text-white font-bold text-lg">FR</div>
                        <div>
                            <h5 class="font-bold text-slate-900">Fernanda Rocha</h5>
                            <p class="text-xs text-slate-500">Confeiteira Autônoma</p>
                        </div>
                    </div>
                </div>

                <!-- Depoimento 2 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/10 relative flex flex-col h-full">
                    <span class="material-symbols-outlined text-primary/20 text-5xl absolute top-6 right-6" aria-hidden="true">format_quote</span>
                    <p class="text-slate-700 leading-relaxed mb-6 relative z-10 flex-grow">
                        "Tava com problema sério travando certidões na Receita e prazo curtíssimo pra licitação. Os caras desenrolaram tudo em dois dias. Cobrei retorno três vezes e sempre me responderam sem enrolar."
                    </p>
                    <div class="flex items-center gap-4 mt-auto">
                        <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg">RO</div>
                        <div>
                            <h5 class="font-bold text-slate-900">Ricardo Oliveira</h5>
                            <p class="text-xs text-slate-500">Dono de Oficina Mecânica</p>
                        </div>
                    </div>
                </div>

                <!-- Depoimento 3 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/10 relative flex flex-col h-full">
                    <span class="material-symbols-outlined text-primary/20 text-5xl absolute top-6 right-6" aria-hidden="true">format_quote</span>
                    <p class="text-slate-700 leading-relaxed mb-6 relative z-10 flex-grow">
                        "Passamos anos pagando imposto a mais porque no antigo escritório nosso enquadramento tava largado. Sentaram com a gente, fizeram um estudo pro restaurante e no 1º trimestre o alívio no caixa foi absurdo."
                    </p>
                    <div class="flex items-center gap-4 mt-auto">
                        <div class="w-12 h-12 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-lg">CE</div>
                        <div>
                            <h5 class="font-bold text-slate-900">Carlos E. Mendes</h5>
                            <p class="text-xs text-slate-500">Sócio de Restaurante</p>
                        </div>
                    </div>
                </div>

                <!-- Depoimento 4 -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/10 relative flex flex-col h-full">
                    <span class="material-symbols-outlined text-primary/20 text-5xl absolute top-6 right-6" aria-hidden="true">format_quote</span>
                    <p class="text-slate-700 leading-relaxed mb-6 relative z-10 flex-grow">
                        "Sabe o que é mais legal? Eles não vêm falar 'contabilês' com você. Sou dentista, não entendo de Darf. Chega no fim do mês eles me mandam um resumo mastigado pelo zap e a guia certinha pra pagar. Simples."
                    </p>
                    <div class="flex items-center gap-4 mt-auto">
                        <div class="w-12 h-12 rounded-full bg-purple-500 flex items-center justify-center text-white font-bold text-lg">AN</div>
                        <div>
                            <h5 class="font-bold text-slate-900">Dra. Amanda Nunes</h5>
                            <p class="text-xs text-slate-500">Cirurgiã-Dentista</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Section -->
    <section data-aos="fade-up" class="py-24 bg-surface-container-low">
        <div class="max-w-7xl mx-auto px-8">
            <div class="flex justify-between items-end mb-12">
                <div>
                    <span class="text-primary font-bold tracking-[0.2em] uppercase text-xs">Conhecimento</span>
                    <h2 class="text-4xl mt-4 font-headline">Blog Fiscal & Gestão</h2>
                </div>
                <a class="text-primary font-semibold hover:underline hidden md:block" href="/blog">Ver todos os artigos</a>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <article data-aos="zoom-in" class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="/assets/img/image_17.jpg"
                             alt="Dashboard financeiro em tablet mostrando gráficos de barras"
                             class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                             width="600" height="192" loading="lazy" decoding="async" />
                    </div>
                    <div class="p-6">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2 block">Empresas</span>
                        <h3 class="text-lg font-bold mb-3 hover:text-primary transition-colors cursor-pointer">Como migrar de MEI para ME: O guia definitivo 2026</h3>
                        <p class="text-sm text-slate-500 mb-4 line-clamp-2">Entenda o momento certo e os benefícios fiscais da transição para o regime de microempresa.</p>
                        <span class="text-xs text-slate-400">5 min de leitura</span>
                    </div>
                </article>
                <article data-aos="zoom-in" class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="/assets/img/image_18.jpg"
                             alt="Documentos legais e caneta em mesa limpa com sombras suaves"
                             class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                             width="600" height="192" loading="lazy" decoding="async" />
                    </div>
                    <div class="p-6">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2 block">Tributário</span>
                        <h3 class="text-lg font-bold mb-3 hover:text-primary transition-colors cursor-pointer">Planejamento Tributário: Onde estão os custos ocultos?</h3>
                        <p class="text-sm text-slate-500 mb-4 line-clamp-2">Identificamos as 3 áreas onde pequenas empresas mais pagam impostos indevidos no Brasil.</p>
                        <span class="text-xs text-slate-400">8 min de leitura</span>
                    </div>
                </article>
                <article data-aos="zoom-in" class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <div class="h-48 overflow-hidden">
                        <img src="/assets/img/image_19.jpg"
                             alt="Profissional sorridente no escritório olhando para laptop"
                             class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                             width="600" height="192" loading="lazy" decoding="async" />
                    </div>
                    <div class="p-6">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2 block">Gestão</span>
                        <h3 class="text-lg font-bold mb-3 hover:text-primary transition-colors cursor-pointer">BPO Financeiro: Por que terceirizar a controladoria?</h3>
                        <p class="text-sm text-slate-500 mb-4 line-clamp-2">Descubra como focar 100% no core business enquanto especialistas cuidam do seu caixa.</p>
                        <span class="text-xs text-slate-400">6 min de leitura</span>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- CTA Final -->
    <section data-aos="fade-up" class="py-24">
        <div class="max-w-7xl mx-auto px-8">
            <div class="bg-primary-container rounded-3xl p-12 lg:p-20 text-white relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 right-0 w-1/3 h-full bg-white/5 skew-x-[-20deg] translate-x-20"></div>
                <div class="lg:grid lg:grid-cols-2 gap-12 items-center relative z-10">
                    <div>
                        <h2 class="text-4xl lg:text-5xl font-headline mb-6">Pronto para o próximo nível?</h2>
                        <p class="text-lg text-primary-fixed opacity-90 mb-8 max-w-md">Solicite uma análise fiscal gratuita e descubra o quanto sua empresa pode economizar mensalmente.</p>
                    </div>
                    <form id="cta-form" class="bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20" action="#" method="POST">
                        <div class="space-y-4">
                            <div>
                                <label for="cta-nome" class="sr-only">Nome Completo</label>
                                <input id="cta-nome" name="nome" required
                                       placeholder="Nome Completo" type="text"
                                       class="w-full bg-white/10 border-0 border-b border-white/30 focus:ring-2 focus:ring-white/50 focus:border-white text-white placeholder-white/60 px-3 py-2 rounded-sm" />
                            </div>
                            <div>
                                <label for="cta-email" class="sr-only">E-mail Corporativo</label>
                                <input id="cta-email" name="email" required type="email"
                                       placeholder="E-mail Corporativo"
                                       class="w-full bg-white/10 border-0 border-b border-white/30 focus:ring-2 focus:ring-white/50 focus:border-white text-white placeholder-white/60 px-3 py-2 rounded-sm" />
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="cta-tel" class="sr-only">Telefone</label>
                                    <input id="cta-tel" name="telefone" type="tel"
                                           placeholder="Telefone"
                                           class="w-full bg-white/10 border-0 border-b border-white/30 focus:ring-2 focus:ring-white/50 focus:border-white text-white placeholder-white/60 px-3 py-2 rounded-sm" />
                                </div>
                                <div>
                                    <label for="cta-empresa" class="sr-only">Empresa</label>
                                    <input id="cta-empresa" name="empresa" type="text"
                                           placeholder="Empresa"
                                           class="w-full bg-white/10 border-0 border-b border-white/30 focus:ring-2 focus:ring-white/50 focus:border-white text-white placeholder-white/60 px-3 py-2 rounded-sm" />
                                </div>
                            </div>
                            <button class="w-full bg-white text-primary py-4 rounded-md font-bold uppercase tracking-widest text-sm hover:bg-slate-100 transition-colors mt-4" type="submit">
                                Receber Análise Gratuita
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
