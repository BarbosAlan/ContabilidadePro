---
/**
 * BaseLayout — Template base para todas as páginas
 * Inclui: <head> completo, OG tags, JSON-LD, skip-link, AOS
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFAB from '../components/WhatsAppFAB.astro';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    currentPage?: string;
    ogImage?: string;
    jsonLd?: object;
    bodyClass?: string;
}

const {
    title,
    description,
    currentPage = 'index',
    ogImage = '/assets/img/image_15.jpg',
    jsonLd,
    bodyClass = ''
} = Astro.props;

const canonicalUrl = `${Astro.site}${currentPage === 'index' ? '' : `/${currentPage}`}`;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ContábilPro" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${Astro.site}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site}${ogImage}`} />

    <!-- Fonts (optimized) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Inter:wght@300;400;500;600;700&display=swap" />

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- AOS CSS -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />

    <!-- JSON-LD Schema -->
    {jsonLd && <script set:html={JSON.stringify(jsonLd)} type="application/ld+json" />}
</head>
<body class:list={['bg-surface text-on-surface selection:bg-primary-container selection:text-white', bodyClass]}>
    <!-- Skip Navigation -->
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>

    <Header currentPage={currentPage} />

    <main id="main-content">
        <slot />
    </main>

    <Footer />
    <WhatsAppFAB />

    <!-- AOS -->
    <script is:inline src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="../scripts/main.js" />
</body>
</html>
